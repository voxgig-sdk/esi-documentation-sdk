# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      format: "int32"
      name: "alliance_id"
      req: false
      short: "The character's alliance ID"
      type: "`$INTEGER`"
    }
    {
      format: "int32"
      name: "ancestry_id"
      req: false
      short: "The character's ancestry ID"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "birthday"
      req: false
      short: "Creation date of the character"
      type: "`$STRING`"
    }
    {
      format: "int32"
      name: "bloodline_id"
      req: false
      short: "The character's bloodline ID"
      type: "`$INTEGER`"
    }
    {
      format: "int32"
      name: "corporation_id"
      req: true
      short: "The character's corporation ID"
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: false
      short: "The character's bio"
      type: "`$STRING`"
    }
    {
      name: "gender"
      req: false
      short: "The character's gender"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The character's name"
      type: "`$STRING`"
    }
    {
      format: "int32"
      name: "race_id"
      req: false
      short: "The character's race ID"
      type: "`$INTEGER`"
    }
    {
      format: "float"
      name: "security_status"
      req: false
      short: "The character's security status"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "character_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                example: "tranquility"
                kind: "query"
                name: "datasource"
                orig: "datasource"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/characters/{character_id}/"
          rename: {
            param: {
              character_id: "id"
            }
          }
          segments: [
            {
              lit: "characters"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "datasource"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
