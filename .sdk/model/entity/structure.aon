# Entity: structure

main: kit: entity: structure: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "x"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "y"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "z"
      req: false
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "structure"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "structure_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                example: "tranquility"
                kind: "query"
                name: "datasource"
                orig: "datasource"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/universe/structures/{structure_id}/"
          rename: {
            param: {
              structure_id: "id"
            }
          }
          segments: [
            {
              lit: "universe"
            }
            {
              lit: "structures"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "datasource"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.position`"
          }
        }
      ]
    }
  }



}
