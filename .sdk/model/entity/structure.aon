    name: "id"
  }

  name: "structure"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "structure_id"
                reqd: true
                type: "`$INTEGER`"
              }
