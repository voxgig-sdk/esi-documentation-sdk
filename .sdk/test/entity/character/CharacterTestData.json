                      "format": "int32",
                      "type": "integer"
                    },
                    "corporation_id": {
                      "description": "The character's corporation ID",
                      "format": "int32",
                      "type": "integer"
                    },
                    "description": {
                      "description": "The character's bio",
                      "type": "string"
                    },
                    "gender": {
                      "description": "The character's gender",
                      "enum": [
                        "male",
                        "female"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "description": "The character's name",
                      "type": "string"
                    },
                    "race_id": {
                      "description": "The character's race ID",
                      "format": "int32",
                      "type": "integer"
                    },
                    "security_status": {
                      "description": "The character's security status",
                      "format": "float",
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "corporation_id"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Public data about a character"
